{
  "name": "splitstorm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "nettest": "esbuild scripts/nettest.ts --bundle --platform=node --outfile=node_modules/.cache/nettest.cjs --log-level=warning && node node_modules/.cache/nettest.cjs",
    "replay": "esbuild scripts/replay.ts --bundle --platform=node --outfile=node_modules/.cache/replay.cjs --log-level=warning && node node_modules/.cache/replay.cjs",
    "fetch-traces": "node scripts/fetch-traces.mjs",
    "report": "esbuild scripts/report.ts --bundle --platform=node --outfile=node_modules/.cache/report.cjs --log-level=warning && node node_modules/.cache/report.cjs",
    "report:serve": "node scripts/report-server.mjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --outfile=node_modules/.cache/balance.cjs --log-level=warning && node node_modules/.cache/balance.cjs",
    "solo": "esbuild scripts/solo.ts --bundle --platform=node --outfile=node_modules/.cache/solo.cjs --log-level=warning && node node_modules/.cache/solo.cjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --outfile=node_modules/.cache/smoke.cjs && node node_modules/.cache/smoke.cjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "peerjs": "^1.5.5"
  }
}
